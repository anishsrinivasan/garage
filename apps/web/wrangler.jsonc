{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "classifieds-web",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  // Pooling in front of PlanetScale. A Worker cannot hold a client-side pool
  // the way a Node server does, so without this every isolate opens its own
  // connection to Hyderabad. packages/db/src/client.workerd.ts reads it.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "3eb81b450be94b398beb54fc7725645f"
    }
  ]
}
