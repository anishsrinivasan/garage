# Copy to .env at the repo root. The scraper and CLI read this directly (Bun
# auto-loads it); Next.js apps read .env from their own directory, so apps/web
# and apps/admin each need their own copy or platform-level env vars.

# --- database -------------------------------------------------------------
DATABASE_URL=postgres://user:pass@host/db
# Session-mode connection for migrations (DDL doesn't survive a transaction
# pooler). Falls back to DATABASE_URL when unset.
# DATABASE_DIRECT_URL=

# --- LLM (extraction + image scoring) -------------------------------------
GOOGLE_API_KEY=
LLM_MODEL=gemini-2.5-flash
# ANTHROPIC_API_KEY=
# LLM_PROVIDER=google|anthropic|openrouter

# OpenRouter: one key for every provider, which matters when comparing
# extraction quality across models for a new vertical. A namespaced model id
# routes here automatically ("google/gemini-2.5-flash"); a bare id
# ("gemini-2.5-flash") still goes direct to Google.
# OPENROUTER_API_KEY=
# OPENROUTER_SITE_URL=https://your-site
# OPENROUTER_APP_NAME=Classifieds

# --- media storage --------------------------------------------------------
# Strongly recommended. Without R2 the scraper stores Instagram CDN URLs, which
# are signed and expire within days, so listings silently lose their photos.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# --- public web app -------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Shared with the cron service and admin so they can bust the listings cache.
REVALIDATE_SECRET=

# --- cron service (apps/cron) ---------------------------------------------
CRON_API_TOKEN=
CRON_SCRAPE_SCHEDULE=30 3 * * *
CRON_MAINTENANCE_SCHEDULE=15 * * * *
CRON_TIMEZONE=Asia/Kolkata
CRON_ENABLED=true
CRON_RUN_ON_START=false
WEB_REVALIDATE_URL=http://localhost:3000/api/revalidate

# --- alerts ---
# Email is the universal channel; Telegram is free, instant and widely used in
# India. WhatsApp reaches more people but its Business API carries per-message
# cost and template review, so it waits until there is demand to justify it.
# RESEND_API_KEY=
# ALERT_FROM_EMAIL=alerts@your-domain
# TELEGRAM_BOT_TOKEN=

# --- admin (apps/admin) ---------------------------------------------------
# openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3001
CRON_SERVICE_URL=http://localhost:3333
NEXT_PUBLIC_WEB_URL=http://localhost:3000
