{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "ALERT_FROM_EMAIL",
    "ANTHROPIC_API_KEY",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "CRON_API_TOKEN",
    "CRON_ENABLED",
    "CRON_MAINTENANCE_SCHEDULE",
    "CRON_RUN_ON_START",
    "CRON_SCRAPE_SCHEDULE",
    "CRON_SERVICE_URL",
    "CRON_TIMEZONE",
    "DATABASE_CONNECT_TIMEOUT",
    "DATABASE_DIRECT_URL",
    "DATABASE_IDLE_TIMEOUT",
    "DATABASE_POOL_MAX",
    "DATABASE_URL",
    "GOOGLE_API_KEY",
    "GOOGLE_GENERATIVE_AI_API_KEY",
    "LLM_MAX_RETRIES",
    "LLM_MODEL",
    "LLM_PROVIDER",
    "NEXT_PUBLIC_BETTER_AUTH_URL",
    "NEXT_PUBLIC_SITE_URL",
    "NEXT_PUBLIC_WEB_URL",
    "OPENROUTER_API_KEY",
    "OPENROUTER_APP_NAME",
    "OPENROUTER_SITE_URL",
    "R2_ACCESS_KEY_ID",
    "R2_ACCOUNT_ID",
    "R2_BUCKET",
    "R2_PUBLIC_BASE_URL",
    "R2_SECRET_ACCESS_KEY",
    "RESEND_API_KEY",
    "REVALIDATE_SECRET",
    "TELEGRAM_BOT_TOKEN",
    "WEB_REVALIDATE_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {}
  }
}
